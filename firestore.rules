rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && data.role in ['renter', 'lender', 'admin']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000));
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && userId == request.auth.uid;
      allow update: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'photoUrl', 'role']);
    }

    // --- Asset Validation ---
    function isValidAsset(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.category is string && data.category.size() > 0
        && data.dailyRate is number && data.dailyRate >= 0
        && data.lenderId is string
        && data.status in ['available', 'rented', 'maintenance']
        && data.location is string;
    }

    match /assets/{assetId} {
      allow read: if true; // Public catalog
      allow create: if isSignedIn(); // Simplified
      allow update: if isSignedIn() && (
        isAdmin() || (
          existing().lenderId == request.auth.uid 
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().lenderId == request.auth.uid);
    }

    // --- Rental Request Validation ---
    function isValidRental(data) {
      return data.assetId is string && data.assetId.size() > 0
        && data.renterId == request.auth.uid
        && data.lenderId is string && data.lenderId.size() > 0
        && data.totalPrice is number && data.totalPrice >= 0
        && data.status in ['pending', 'approved', 'rejected', 'paid', 'completed', 'cancelled']
        && data.startDate is string
        && data.endDate is string;
    }

    match /rentals/{rentalId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn(); // Simplified
      
      allow update: if isSignedIn();
    }

    // --- Notifications ---
    function isValidNotification(data) {
      return data.userId is string 
        && data.title is string 
        && data.message is string 
        && data.read is bool
        && data.type in ['rental_request', 'rental_update', 'return_reminder', 'system'];
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn(); // Simplified
      allow update: if isSignedIn();
    }

    // --- Reviews ---
    function isValidReview(data) {
      return data.assetId is string
        && data.reviewerId == request.auth.uid
        && data.lenderId is string
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000
        && data.rentalId is string;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow list: if true;
      allow create: if isSignedIn() && isEmailVerified() && isValidReview(incoming()) && isValidId(reviewId)
        && exists(/databases/$(database)/documents/rentals/$(incoming().rentalId));
      allow update: if false; // Reviews are immutable for simplicity
      allow delete: if isAdmin() || (isSignedIn() && existing().reviewerId == request.auth.uid);
    }

    // Admin collection
    match /admins/{uid} {
      allow read: if isSignedIn();
    }
  }
}
